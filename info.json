{
  "description": "微信读书专用插件，提供章节提取、全书捕获、目录列表、章节导航和大纲功能",
  "version": "2.0.0",
  "author": "WhizZest",
  "license": "MIT",
  "keywords": [
    "weread",
    "wechat-reading",
    "chrome-cdp",
    "chapter-extraction",
    "book-capture",
    "atob-hook",
    "ebook"
  ],
  "dependencies": {
    "chrome-cdp-skill": "https://github.com/WhizZest/chrome-cdp-skill.git"
  },
  "features": [
    {
      "script": "extract-chapter.mjs",
      "description": "通过拦截页面atob调用获取章节原始base64数据，解码后输出为HTML或Markdown文件",
      "usage": "node extract-chapter.mjs <target> <output-path> [--no-reload] [--markdown] [--verbose]"
    },
    {
      "script": "capture-book.mjs",
      "description": "通过atob Hook + 章节URL跳转方案获取全书内容，自动获取章节目录并逐章提取，输出为Markdown文件",
      "usage": "node capture-book.mjs <target> <output-dir> [--book-id <id>] [--max-chapters <n>] [--delay <ms>] [--verbose]"
    },
    {
      "script": "list-chapters.mjs",
      "description": "列出当前书籍的完整章节目录，包含章节标题和UID，支持表格和JSON两种输出格式",
      "usage": "node list-chapters.mjs <target> [--book-id <id>] [--json] [--verbose]"
    },
    {
      "script": "navigate-chapter.mjs",
      "description": "通过chapterUid直接跳转到指定章节，使用wr_hash算法自动构造章节URL",
      "usage": "node navigate-chapter.mjs <target> <chapterUid> [--book-id <id>] [--verbose]"
    },
    {
      "script": "outline.mjs",
      "description": "获取微信读书AI生成的章节大纲（章节要点摘要），支持终端表格、JSON和Markdown三种输出格式",
      "usage": "node outline.mjs <target> [--book-id <id>] [--chapter <uid>] [--output <file>] [--json] [--verbose]"
    }
  ]
}
